# Copy to backend/.env for local development (backend/.env is git-ignored; never commit it).
# Every value below is a placeholder.

PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=founder_portal_local
PG_USER=fp_local
PG_PASSWORD=change-me
# PG_SSLMODE=require          # for a managed PostgreSQL server
# PG_SSLROOTCERT=/path/to/ca.pem

APP_ENV=local                 # local | dev | replica | production
SESSION_TTL_HOURS=168

# --- Email (optional). Without SMTP_HOST the portal runs in email test mode: every message waits in
# Workspace -> Messages -> Outbox as "not sent", with WhatsApp, email-app and copy buttons.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=portal@example.com
# SMTP_PASSWORD=change-me
# SMTP_FROM=Founder's Resource Portal <portal@example.com>
# SMTP_STARTTLS=1
# PORTAL_URL=http://127.0.0.1:8000

# Sector-news feed reader: off by default (alpha). Suggestions need both switched on.
NEWS_FETCH_ENABLED=0
NEWS_SUGGESTIONS_ENABLED=0

# Sign in with a one-time code by email. Off until live email (SMTP_HOST) is set up.
OTP_SIGNIN_ENABLED=0
